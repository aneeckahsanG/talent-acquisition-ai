# ============================================================
# TalentOps AI — environment variables
# Copy this file to .env and fill in your values.
# .env is loaded automatically on startup (spring-dotenv).
# Never commit .env to version control.
# ============================================================

# ── Claude API ──────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ── JWT ─────────────────────────────────────────────────────
# Minimum 32 characters, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-minimum-32-characters

# ── Database (PostgreSQL - ignored when using dev/H2 profile) ─
DB_USERNAME=talentai
DB_PASSWORD=talentai

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
